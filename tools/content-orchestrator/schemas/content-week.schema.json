{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izzyfbservices.com/schemas/content-week.schema.json",
  "title": "IZZY Content Week",
  "type": "object",
  "additionalProperties": false,
  "required": ["week", "campaign", "audience", "objectives", "items"],
  "properties": {
    "week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "campaign": {"type": "string", "minLength": 1},
    "audience": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_id", "format", "topic", "status"],
        "properties": {
          "content_id": {"type": "string"},
          "day": {"type": ["string", "null"]},
          "date": {"type": ["string", "null"], "format": "date"},
          "format": {"enum": ["carousel", "reel", "story", "static", "video", "other"]},
          "topic": {"type": "string", "minLength": 1},
          "status": {"enum": ["idea", "planned", "production", "qa", "approved", "draft", "scheduled", "published", "measured"]},
          "brief_path": {"type": ["string", "null"]}
        }
      }
    }
  }
}
